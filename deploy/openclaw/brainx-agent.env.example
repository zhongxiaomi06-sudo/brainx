# 安装为 /etc/brainx/agent.env，权限 0640 root:brainx；必须分别随机生成，不得复用。
BRAINX_AGENT_GATEWAY_TOKEN=replace-with-random-32-byte-value
BRAINX_AGENT_ASSERTION_SECRET=replace-with-random-32-byte-value
BRAINX_AGENT_AUDIT_KEY=replace-with-random-32-byte-value
BRAINX_AGENT_FEISHU_APP_KEYS_JSON='{"mia":"replace-with-a-separate-random-app-binding-key"}'
BRAINX_AGENT_ADMIN_ID=replace-admin-operator-id
BRAINX_AGENT_ADMIN_ALLOWLIST=replace-admin-operator-id
BRAINX_DB=/opt/brainx/data/brainx.db
BRAINX_FEISHU_CREDENTIALS_FROM_OPENCLAW=1
BRAINX_OPENCLAW_CONFIG_PATH=/var/lib/brainx/.openclaw/openclaw.json
BRAINX_FEISHU_DOC_BASE_URL=https://replace-with-tenant.feishu.cn

# 新群准入：openclaw CLI 必须以 brainx 用户运行（其配置归属校验拒绝 root 直读 600 配置）；
# 串行 5 次 CLI 调用约 25s，默认 20s 超时会必然失败（2026-09-12 生产实证）。
BRAINX_OPENCLAW_RUN_AS=brainx
BRAINX_OPENCLAW_TIMEOUT_MS=90000

# Agent Gateway 只读取已处理数据，账号仅授予 brainx_talent 的 SELECT。
BRAINX_MYSQL_HOST=replace-rds-host
BRAINX_MYSQL_PORT=3306
BRAINX_MYSQL_DATABASE=brainx_talent
BRAINX_MYSQL_USER=brainx_agent_readonly
BRAINX_MYSQL_PASSWORD=replace-readonly-password
BRAINX_MYSQL_SSL=1
