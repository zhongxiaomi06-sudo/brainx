[Unit]
Description=BrainX feedback metrics rollup (specs/019 US3)
After=network-online.target brainx.service
Wants=network-online.target

[Service]
Type=oneshot
User=brainx
Group=brainx
WorkingDirectory=/opt/brainx
EnvironmentFile=/etc/brainx/worker.env
ExecStartPre=/usr/bin/node /opt/brainx/bin/brainx-runtime-preflight.mjs
ExecStart=/usr/bin/node /opt/brainx/bin/brainx-feedback-rollup.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/brainx/data

[Install]
WantedBy=multi-user.target
