# 安装为 /etc/brainx/worker.env，权限 0640 root:brainx；不得复用 Agent Gateway 账号。
BRAINX_DB=/opt/brainx/data/brainx.sqlite
BRAINX_RELOOP_SYNC_ENABLED=1
BRAINX_MATCH_EVAL_ENABLED=1
BRAINX_DOCUMENT_PARSER_ENABLED=1
# 只有数据责任人批准完整文档进入已配置模型后才能设为 1。
BRAINX_DOCUMENT_LLM_ENABLED=0
BRAINX_DOCUMENT_STAGING_ROOT=/opt/brainx/data/document-staging
BRAINX_EVALUATION_ROOT=/opt/brainx/data/evaluations
BRAINX_EVALUATION_REPORT_ROOT=/opt/brainx/data/evaluations/reports

# reloop 结构化来源绑定；必须由数据责任人核对，不得从聊天文本推断。
BRAINX_TENANT_ID=replace-tenant-id
BRAINX_RELOOP_CONSULTANT_ID=replace-consultant-id
BRAINX_RELOOP_SOURCE_OWNER_ID=replace-source-owner-id
BRAINX_RELOOP_EXPECTED_BOUND_NAME=replace-verified-bound-name
BRAINX_RELOOP_PAGE_SIZE=100

# Worker：reloop_app 只读；brainx_talent 仅 SELECT/INSERT/UPDATE/DELETE。DDL 另用临时迁移账号。
BRAINX_MYSQL_HOST=replace-rds-host
BRAINX_MYSQL_PORT=3306
BRAINX_MYSQL_DATABASE=brainx_talent
BRAINX_MYSQL_USER=brainx_worker_runtime
BRAINX_MYSQL_PASSWORD=replace-worker-password
BRAINX_MYSQL_SSL=1

# 仅在 BRAINX_DOCUMENT_LLM_ENABLED=1 时配置；密钥不得写入仓库。
BRAINX_LLM_BASE_URL=replace-model-base-url
BRAINX_LLM_API_KEY=replace-model-api-key
BRAINX_LLM_MODEL=replace-model-name
