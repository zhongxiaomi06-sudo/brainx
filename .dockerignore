# 构建镜像时排除的内容，避免把巨大/敏感文件塞进 build context
node_modules
**/node_modules
.git
.env
.env.*
!.env.example
*.log
frontend/**/dist
frontend/**/.wrangler
frontend/**/.next
data/*.db
data/*.sqlite
*.pdf
# 收敛后旧前端与归档，不进镜像（减小体积）
frontend/decision-workbench
_archive
scripts/session/.state.enc
scripts/session/out
