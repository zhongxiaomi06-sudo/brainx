[Unit]
Description=BrainX event dispatcher (specs/019 US2)
After=network-online.target brainx.service
Wants=network-online.target

[Service]
Type=simple
User=brainx
Group=brainx
WorkingDirectory=/opt/brainx
EnvironmentFile=/etc/brainx/worker.env
ExecStartPre=/usr/bin/node /opt/brainx/bin/brainx-runtime-preflight.mjs
ExecStart=/usr/bin/node /opt/brainx/bin/brainx-dispatcher.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/brainx/data

[Install]
WantedBy=multi-user.target
