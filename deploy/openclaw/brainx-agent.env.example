# 安装为 /etc/brainx/agent.env，权限 0640 root:brainx；必须分别随机生成，不得复用。
BRAINX_AGENT_GATEWAY_TOKEN=replace-with-random-32-byte-value
BRAINX_AGENT_ASSERTION_SECRET=replace-with-random-32-byte-value
BRAINX_AGENT_AUDIT_KEY=replace-with-random-32-byte-value
BRAINX_AGENT_FEISHU_APP_KEYS_JSON='{"mia":"replace-with-a-separate-random-app-binding-key"}'
BRAINX_AGENT_ADMIN_ID=replace-admin-operator-id
BRAINX_AGENT_ADMIN_ALLOWLIST=replace-admin-operator-id
BRAINX_RELOOP_SYNC_ENABLED=1
BRAINX_MATCH_EVAL_ENABLED=1
BRAINX_DOCUMENT_PARSER_ENABLED=1
# 只有数据责任人批准完整文档进入已配置模型后才能设为 1。
BRAINX_DOCUMENT_LLM_ENABLED=0
BRAINX_DOCUMENT_STAGING_ROOT=/opt/brainx/data/document-staging
BRAINX_EVALUATION_ROOT=/opt/brainx/data/evaluations
BRAINX_EVALUATION_REPORT_ROOT=/opt/brainx/data/evaluations/reports
BRAINX_DB=/opt/brainx/data/brainx.sqlite

# 人才 RDS 运行账号只授予本项目库的 SELECT/INSERT/UPDATE/DELETE；DDL 迁移另用临时账号。
# 完整证书与密码仅存在该受保护文件或系统密钥服务。
BRAINX_MYSQL_HOST=replace-rds-host
BRAINX_MYSQL_PORT=3306
BRAINX_MYSQL_DATABASE=brainx_talent
BRAINX_MYSQL_USER=brainx_agent_runtime
BRAINX_MYSQL_PASSWORD=replace-runtime-password
BRAINX_MYSQL_SSL=1
