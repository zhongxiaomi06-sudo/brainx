[Unit]
Description=BrainX recoverable integration worker
After=network-online.target brainx.service
Wants=network-online.target

[Service]
Type=simple
User=brainx
Group=brainx
WorkingDirectory=/opt/brainx
EnvironmentFile=/etc/brainx/worker.env
ExecStart=/usr/bin/node /opt/brainx/bin/brainx-integration-worker.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/brainx/data

[Install]
WantedBy=multi-user.target
