{
  "name": "brainx-local",
  "version": "1.0.0",
  "description": "Brain X 职位决策工作台（本地版）：SQLite + node:http + 零依赖前端",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "mysql2": "^3.23.3"
  },
  "scripts": {
    "dev": "node src/server.js",
    "dev:frontend-only": "cd frontend/btex-frontend && WRANGLER_LOG_PATH=.wrangler/wrangler.log ./node_modules/.bin/vinext dev --host 127.0.0.1 --port 4321",
    "build": "cd frontend/btex-frontend && WRANGLER_LOG_PATH=.wrangler/wrangler.log ./node_modules/.bin/vinext build",
    "start": "node src/server.js",
    "start:frontend-only": "cd frontend/btex-frontend && WRANGLER_LOG_PATH=.wrangler/wrangler.log ./node_modules/.bin/vinext start --host 127.0.0.1 --port 4321",
    "frontend:install": "npm --prefix frontend/btex-frontend install",
    "sync": "node bin/brainx-sync.mjs",
    "ttc-sync": "node bin/brainx-ttc-sync.mjs",
    "openmai": "node bin/brainx-openmai.mjs",
    "adapter": "node bin/brainx-adapter.mjs",
    "recommend": "node bin/brainx-recommend.mjs",
    "replay": "node bin/brainx-replay.mjs",
    "push": "node bin/brainx-push.mjs",
    "web": "node src/server.js",
    "fixture": "node scripts/build_fixture.mjs",
    "init-talent": "node scripts/init-talent-schema.mjs",
    "talent:e2e": "node scripts/e2e-talent-flow.mjs",
    "talent:health": "node scripts/talent-health.mjs",
    "data:pull": "node scripts/pull-cloud-data.mjs",
    "data:audit": "node scripts/pull-cloud-data.mjs --audit-only",
    "diagnose": "node scripts/diagnose-policy.mjs",
    "label:export": "node scripts/export-labeling-sheet.mjs",
    "label:import": "node bin/brainx-label-import.mjs",
    "outcome:import": "node bin/brainx-outcome-import.mjs",
    "test": "node --experimental-strip-types --test --test-force-exit \"tests/*.test.mjs\"",
    "test:quality-gate": "node --test tests/quality-gate.test.mjs",
    "verify:quick": "node scripts/quality-gate.mjs --profile quick",
    "verify": "node scripts/quality-gate.mjs --profile full",
    "verify:ci": "node scripts/quality-gate.mjs --profile ci",
    "frontend:health": "node scripts/frontend-health.mjs",
    "storybook": "npm --prefix frontend/btex-frontend run storybook",
    "storybook:build": "npm --prefix frontend/btex-frontend run storybook:build",
    "storybook:test": "npm --prefix frontend/btex-frontend run storybook:test",
    "eval:ranking": "node scripts/eval-ranking.mjs"
  },
  "bin": {
    "braintex-local-sync": "bin/brainx-sync.mjs",
    "braintex-local-adapter": "bin/brainx-adapter.mjs",
    "braintex-local-recommend": "bin/brainx-recommend.mjs",
    "braintex-local-replay": "bin/brainx-replay.mjs",
    "braintex-local-push": "bin/brainx-push.mjs",
    "braintex-local-web": "bin/brainx-web.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}