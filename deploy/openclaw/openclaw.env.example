# 安装为 /etc/brainx/openclaw.env，权限 0640 root:brainx。
OPENCLAW_GATEWAY_TOKEN=replace-with-random-32-byte-value
BRAINX_FEISHU_APP_ID=cli_replace
BRAINX_FEISHU_APP_SECRET=replace-feishu-secret
BRAINX_FEISHU_ALLOWED_OPEN_ID=ou_replace
BRAINX_FEISHU_ALLOWED_CHAT_ID=oc_replace
BRAINX_AGENT_GATEWAY_TOKEN=must-equal-agent.env
BRAINX_AGENT_ASSERTION_SECRET=must-equal-agent.env

# 至少配置一个 OpenClaw 支持的模型凭证；示例：
OPENAI_API_KEY=replace-model-provider-key
