[Unit]
Description=BrainX least-privilege Agent Gateway
After=network-online.target brainx.service
Wants=network-online.target

[Service]
Type=simple
User=brainx
Group=brainx
WorkingDirectory=/opt/brainx
EnvironmentFile=/etc/brainx/agent.env
# specs/014：接单成功后要由网关自己发「找人卡」，需要应用身份的飞书凭证。
# 只挂这两个键，避免整挂 openclaw.env 覆盖 agent.env 的同名键。
EnvironmentFile=/etc/brainx/feishu-bot.env
# specs/015：深链与项目群卡片生成需要 BRAINX_BASE_URL。本服务以 brainx 用户运行，
# 读不到 root:600 的 /opt/brainx/.env（含 BRAINX_DEV_AUTH，禁止整体挂载），故单独提供。
# 缺失时 brainx_bind_group_project 以 BRAINX_BASE_URL_REQUIRED 失败
# （2026-09-11 felix 在「linda -投放增长转项群」绑定失败事故）。
EnvironmentFile=/etc/brainx/base-url.env
Environment=BRAINX_AGENT_GATEWAY_HOST=127.0.0.1
Environment=BRAINX_AGENT_GATEWAY_PORT=3102
ExecStartPre=/usr/bin/node /opt/brainx/bin/brainx-runtime-preflight.mjs
ExecStart=/usr/bin/node /opt/brainx/bin/brainx-agent-gateway.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# /var/lib/brainx/.openclaw：新群准入需要 openclaw CLI 读写其配置（2026-09-12 生产实证：
# ProtectSystem=strict 下该路径只读会报 OPENCLAW_GROUP_ALLOWLIST_FAILED）。
# 另注意：agent.env 必须配 BRAINX_OPENCLAW_RUN_AS=brainx——本单元若未显式 User=brainx
# 而以 root 运行，openclaw CLI 的配置归属校验会拒绝 root 直读 600 配置。
ReadWritePaths=/opt/brainx/data /var/lib/brainx/.openclaw

[Install]
WantedBy=multi-user.target
