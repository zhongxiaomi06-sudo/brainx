# 安装为 /etc/brainx/feishu-bot.env，权限 0640 root:brainx。
#
# brainx-agent-gateway 的第二个 EnvironmentFile：应用身份凭证，用于工具执行期
# 由网关自己发卡（specs/014 接单后的「找人卡」补发、specs/015 绑定群后的
# 找人卡与拉群指引卡）。
#
# 只放这两个键，不要整挂 /etc/brainx/openclaw.env —— 那会覆盖 agent.env 的同名键。
BRAINX_FEISHU_APP_ID=replace-with-feishu-app-id
BRAINX_FEISHU_APP_SECRET=replace-with-feishu-app-secret
