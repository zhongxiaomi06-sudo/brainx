# Brain X 本地配置（复制为 .env 并填入真实值；.env 已在 .gitignore，永不提交）
# 飞书应用密钥：开发者后台 → 凭证与基础信息 → App Secret（或从 1Password 读取）
BRAINX_FEISHU_APP_SECRET=填你的AppSecret
# 可选覆盖：
# BRAINX_FEISHU_APP_ID=cli_aaf72a911bb9dd21   # 默认已是 braintex 小机器人
# BRAINX_LARK_PROFILE=york-ai   # lark-cli 命名 profile（多应用并存时显式指定身份）
# BRAINX_PORT=3000
# BRAINX_BASE_URL=http://127.0.0.1:3000
# BRAINX_DEV_AUTH=1   # 离线演示后门（跳过 OAuth 的身份选择器），生产别开
# BRAINX_PUSH_TARGET=ou_xxx 或 oc_xxx   # brainx-push 默认推送目标

# ---- 飞书私聊个人 Agent 模型（生产开启；凭据由每位顾问在 HTTPS 设置页提交）----
# 服务器不提供全员默认模型，也不共享任何顾问的 API Key。
# BRAINX_PERSONAL_MODELS_ENABLED=1
# BRAINX_OPENCLAW_BIN=/usr/local/bin/openclaw
# BRAINX_OPENCLAW_STATE_DIR=/var/lib/brainx/.openclaw
# BRAINX_OPENCLAW_CONFIG_PATH=/var/lib/brainx/.openclaw/openclaw.json
# BRAINX_OPENCLAW_FEISHU_ACCOUNT_ID=mia
# BRAINX_OPENCLAW_RUN_AS=brainx

# ---- B-tex React/Vinext 前端（单地址模式）----
# 默认由 Brain X 启动 frontend/btex-frontend 并代理到 3000；无需单独开前端终端。
# BRAINX_FRONTEND_PORT=4321
# BRAINX_FRONTEND_HOST=127.0.0.1
# BRAINX_FRONTEND_OFF=1   # 关闭新前端，回退到 public/ 静态页面

# P4：重大变化自动推卡（仅推顾问本人，绝不推群）。默认关，显式开：
# BRAINX_PUSH_AUTO=1

# ---- 阿里云 RDS MySQL（人才库；走外网地址，需先在 RDS 控制台加本机公网 IP 白名单）----
# 外网地址默认已填在 db.js，一般只用改下面三行：
BRAINX_MYSQL_USER=填RDS账号
BRAINX_MYSQL_PASSWORD=填RDS密码
BRAINX_MYSQL_DATABASE=brainx
# 可选覆盖（默认外网地址 + 3306）：
# BRAINX_MYSQL_HOST=ttc-rds-public-0707.mysql.rds.aliyuncs.com
# BRAINX_MYSQL_PORT=3306
# BRAINX_MYSQL_SSL=1   # 外网连 RDS 建议开 SSL（需配 CA，见 db.js 注释）

# ---- OpenClaw 单顾问/单租户 MCP PoC（多人生产不能使用这组静态绑定）----
# 两项同时有效时才外露 brainx_candidate_shortlist；值由管理员按内部映射填写，不能让模型传入。
# BRAINX_MCP_CONSULTANT_ID=mia
# BRAINX_MCP_TENANT_ID=填内部租户ID

# ---- LLM（CSV->标准库格式适配器；OpenAI 兼容协议，一套配置兼容 DeepSeek/通义/Kimi/OpenAI）----
# 适配器读两份原始 CSV（公司岗位情况 + Felix 项目池），用大模型把脏文本分类成
# 标准方向/驾驶舱状态。不填 key 也能跑（走确定性关键词回退），只是分类精度略低。
# 常见服务商 BASE_URL / MODEL：
#   DeepSeek  https://api.deepseek.com/v1                        deepseek-chat
#   通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus
#   Kimi      https://api.moonshot.cn/v1                         moonshot-v1-8k
#   OpenAI    https://api.openai.com/v1                          gpt-4o-mini
BRAINX_LLM_BASE_URL=https://api.deepseek.com/v1
BRAINX_LLM_API_KEY=
BRAINX_LLM_MODEL=deepseek-chat
# BRAINX_LLM_TIMEOUT_MS=45000   # 单次请求超时（默认 45s）
# 阶跃星辰 Step Plan（BrainX 助手当前生产档：step-3.7-flash，驱动 agent loop 工具调用）：
# BRAINX_LLM_BASE_URL=https://api.stepfun.com/step_plan/v1
# BRAINX_LLM_MODEL=step-3.7-flash
# ⚠ EXTRA_BODY 必须写合法 JSON——反斜杠转义引号({\"...\"})会被 llm.js 的 catch 静默吞掉等于没配。
# {}=保留推理(助手默认,工具调用质量优先);{"thinking":{"type":"disabled"}} 可省 ~30x token,
# 但关推理前必须在助手问答路径实测过工具调用仍正常,不要未测上线。
# BRAINX_LLM_EXTRA_BODY={}
# ---- BrainX 助手 agent 旋钮（默认值见 src/agent/loop.js / registry.js / skills.js）----
# BRAINX_AGENT_MAX_ROUNDS=8             # agent loop 最大工具轮次
# BRAINX_AGENT_TOTAL_TIMEOUT_MS=180000  # 单次问答总超时
# BRAINX_AGENT_SQL=0                    # 关掉 query_sql 工具(云版逃生门)
# BRAINX_AGENT_GLOBAL_SKILLS=1          # 加扫 ~/.agents/skills/brainx-*(本地调试,云版勿开)
# ---- 职位快照接口（外部系统消费，替代直打 CRM job/search）----
# 必须设置：未设置时 GET /api/v1/jobs/snapshot 一律 401（fail-closed）。
# York AI worker 等外部系统用此 key 读 BrainX 已同步去重的职位快照（bridge 每 3 分钟刷新），
# 而不是各自打 TTC CRM job/search（每请求触发小麦 N+1 跨云调用）。
# BRAINX_SNAPSHOT_API_KEY=用 openssl rand -hex 32 生成一个长随机串

# ---- 请求带宽/调用量预测告警（bin/brainx-guard.mjs 看门狗）----
# 可选：告警推送目标（飞书群自定义机器人 webhook）。不配则只打控制台。
# BRAINX_GUARD_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx


# ---- 推送卡片一键反馈（src/quickfb.js，2026-08-24 F2）----
# 卡片「👀 关注 / ✕ 不感兴趣」按钮的 HMAC 签名密钥。不配则按钮不渲染、端点 503（fail-closed）。
# BRAINX_FEEDBACK_SECRET=用 openssl rand -hex 32 生成一个长随机串
