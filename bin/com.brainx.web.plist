<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.brainx.web</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__ROOT__/src/server.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BRAINX_PORT</key>
    <string>3100</string>
    <!-- OAuth 回调地址必须与飞书后台白名单一致；缺省会回落 3000 → 错误码 20029 -->
    <key>BRAINX_BASE_URL</key>
    <string>http://127.0.0.1:3100</string>
    <!-- 2026-08-24 决策：本地 launchd 降级纯开发，关停 bridge 与定时推送（推送唯一出口=云端容器）。
         要恢复本地桥接：删 BRAINX_BRIDGE_OFF，改回 BRAINX_BRIDGE_INTERVAL_MS=180000 -->
    <key>BRAINX_BRIDGE_OFF</key>
    <string>1</string>
    <key>BRAINX_PUSH_SCHEDULE</key>
    <string>0</string>
    <!-- spawn npm 启动 btex-frontend 需要 Homebrew PATH（launchd 默认 PATH 无 /opt/homebrew/bin → spawn npm ENOENT） -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- 重大变化自动推卡默认关；要开启把下一行取消注释（仅推顾问本人，绝不推群） -->
    <!-- <key>BRAINX_PUSH_AUTO</key><string>1</string> -->
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__ROOT__/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/logs/launchd.err.log</string>
</dict>
</plist>
