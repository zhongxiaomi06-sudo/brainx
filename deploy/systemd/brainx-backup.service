[Unit]
Description=BrainX daily consistent snapshot backup (specs/021 US1)
After=network-online.target brainx.service
Wants=network-online.target

[Service]
Type=oneshot
User=brainx
Group=brainx
WorkingDirectory=/opt/brainx
EnvironmentFile=/etc/brainx/worker.env
ExecStartPre=/usr/bin/node /opt/brainx/bin/brainx-runtime-preflight.mjs
ExecStart=/usr/bin/node /opt/brainx/bin/brainx-backup.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/brainx/data /opt/brainx/backups
